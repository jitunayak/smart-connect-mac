<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>smartconnect-mac-helper</string>
	<key>CFBundleIdentifier</key>
	<string>app.smartconnect.mac.helper</string>
	<key>CFBundleName</key>
	<string>SmartConnect Helper</string>
	<key>LSBackgroundOnly</key>
	<true/>
